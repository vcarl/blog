{%- macro snippet(post, level='h3') -%}
<div class="snippet">
  <{{ level }}><a href="{{ post.url }}">{{ post.data.title }}</a></{{ level }}>
  <p>
    <small>{{ post.date | ymd }}. {{ ((post.content | timeToRead) * 1.3) | round(0, 'floor') }} minutes to read</small>
    {%- if caller %}<br>{{ caller() }}{% endif %}
  </p>
</div>
{%- endmacro -%}
